{
  "name": "bookshop",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1.16.1",
    "@cap-js/hana": "^3",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve --with-mocks",
    "watch-books": "cds watch --open books/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "features": {
      "with_mocks": true
    },
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "viewer": {
            "roles": [
              "Viewer"
            ]
          },
          "admin": {
            "roles": [
              "Admin"
            ]
          },
          "richard.musime@moyotech.net": {
            "roles": [
              "Viewer",
              "Admin"
            ]
          }
        }
      },
      "API_BUSINESS_PARTNER": {
        "kind": "odata-v2",
        "model": "srv/external/API_BUSINESS_PARTNER",
        "[production]": {
          "kind": "mocked"
        }
      },
      "[production]": {
        "auth": "xsuaa"
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/books"
  ]
}
